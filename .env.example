# ──────────────────────────────────────────────────────────────────────────────
# Hindsight Follow-Up Copilot — environment template
# Copy to `.env.local` (gitignored) and fill in real values.
# The app RUNS with no keys at all (mock LLM + local memory provider),
# and automatically upgrades when these are provided.
# ──────────────────────────────────────────────────────────────────────────────

# ── Hindsight (agent memory) ──────────────────────────────────────────────────
# Hindsight Cloud endpoint. Memory provider stays "local" (file-backed) until
# this + HINDSIGHT_API_KEY are both set.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Memory bank for the demo AE's account knowledge. Any string; one bank = one "brain".
HINDSIGHT_BANK_ID=acme-sales-copilot

# ── LLM (reasoning + drafting) ──────────────────────────────────────────────
# Live LLM = Groq (OpenAI-compatible Chat Completions endpoint).
# Leave GROQ_API_KEY empty to use the deterministic mock LLM (no network).
# The key lives only in .env.local (gitignored) and is never logged or returned.
GROQ_API_KEY=
# Optional overrides — the defaults are already correct for Groq.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Live-call timeout in ms (default 25000). 429/503 rate limits are retried
# automatically with backoff (max 2 retries, ≤15s wait).
# LLM_TIMEOUT_MS=25000

# ── App ───────────────────────────────────────────────────────────────────────
# File-backed persistence directory for runs/outcomes (JSON lines).
DATA_DIR=./.data
